import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'package:url_launcher/url_launcher.dart';

import '../../theme/mega_theme.dart';
import '../../core/auth_state.dart';
import '../../core/api_client.dart';

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  List<dynamic> _foods = [];
  List<dynamic> _banners = [];
  List<dynamic> _categories = [];
  String? _selectedCategoryId;
  int _selectedTab = 0;
  String _searchQuery = '';
  final Map<String, Map<String, dynamic>> _cart = {};
  bool _loading = true;
  String? _error;

  int get _cartCount => _cart.values.fold(
        0,
        (sum, item) => sum + (item['quantity'] as int),
      );

  double get _subtotal => _cart.values.fold(
        0.0,
        (sum, item) =>
            sum +
            (double.tryParse('${item['food']['base_price']}') ?? 0) *
                (item['quantity'] as int),
      );

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    if (mounted) {
      setState(() {
        _loading = true;
        _error = null;
      });
    }

    try {
      final api = context.read<ApiClient>();
      final results = await Future.wait([
        api.get('/api/v1/menu/foods'),
        api.get('/api/v1/banners'),
        api.get('/api/v1/menu/categories'),
      ]);

      if (!mounted) return;
      setState(() {
        _foods = results[0]['foods'] as List? ?? [];
        _banners = results[1]['banners'] as List? ?? [];
        _categories = results[2]['categories'] as List? ?? [];
      });
    } catch (e) {
      if (mounted) setState(() => _error = 'Unable to load menu: $e');
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  void _addFood(Map<String, dynamic> food) {
    final id = '${food['id'] ?? ''}';
    if (id.isEmpty || food['available'] != true) return;

    setState(() {
      if (_cart.containsKey(id)) {
        _cart[id]!['quantity'] = (_cart[id]!['quantity'] as int) + 1;
      } else {
        _cart[id] = {'food': food, 'quantity': 1};
      }
    });

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('${food['name'] ?? food['name_en']} added to cart'),
        duration: const Duration(milliseconds: 900),
      ),
    );
  }

  void _changeQuantity(String id, int delta, StateSetter updateSheet) {
    final item = _cart[id];
    if (item == null) return;

    final next = (item['quantity'] as int) + delta;
    if (next <= 0) {
      _cart.remove(id);
    } else {
      item['quantity'] = next;
    }

    setState(() {});
    updateSheet(() {});
  }

  Future<void> _openCart() async {
    if (_cart.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Your cart is empty. Add food first.')),
      );
      return;
    }

    final formKey = GlobalKey<FormState>();
    final nameController = TextEditingController();
    final phoneController = TextEditingController();
    final addressController = TextEditingController();
    final instructionsController = TextEditingController();

    String paymentMethod = 'cod';
    bool submitting = false;

    try {
      await showModalBottomSheet<void>(
        context: context,
        isScrollControlled: true,
        useSafeArea: true,
        builder: (sheetContext) {
          return StatefulBuilder(
            builder: (context, updateSheet) {
              return Padding(
                padding: EdgeInsets.only(
                  left: 20,
                  right: 20,
                  top: 20,
                  bottom: MediaQuery.of(context).viewInsets.bottom + 20,
                ),
                child: SingleChildScrollView(
                  child: Form(
                    key: formKey,
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Row(
                          children: [
                            Expanded(
                              child: Text(
                                'Your Cart',
                                style: Theme.of(context).textTheme.headlineSmall,
                              ),
                            ),
                            IconButton(
                              onPressed: () => Navigator.pop(sheetContext),
                              icon: const Icon(Icons.close),
                            ),
                          ],
                        ),
                        ..._cart.entries.map((entry) {
                          final id = entry.key;
                          final food = entry.value['food'] as Map<String, dynamic>;
                          final qty = entry.value['quantity'] as int;
                          final price =
                              double.tryParse('${food['base_price']}') ?? 0;

                          return ListTile(
                            contentPadding: EdgeInsets.zero,
                            title: Text('${food['name'] ?? food['name_en']}'),
                            subtitle: Text(
                              'NPR ${(price * qty).toStringAsFixed(2)}',
                            ),
                            leading: IconButton(
                              onPressed: () =>
                                  _changeQuantity(id, -1, updateSheet),
                              icon: const Icon(Icons.remove_circle_outline),
                            ),
                            trailing: Row(
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                Text('$qty'),
                                IconButton(
                                  onPressed: () =>
                                      _changeQuantity(id, 1, updateSheet),
                                  icon: const Icon(Icons.add_circle_outline),
                                ),
                              ],
                            ),
                          );
                        }),
                        const Divider(),
                        Align(
                          alignment: Alignment.centerRight,
                          child: Text(
                            'Items subtotal: NPR ${_subtotal.toStringAsFixed(2)}',
                            style: Theme.of(context).textTheme.titleMedium,
                          ),
                        ),
                        const SizedBox(height: 16),
                        Text(
                          'Delivery details',
                          style: Theme.of(context).textTheme.titleLarge,
                        ),
                        const SizedBox(height: 12),
                        TextFormField(
                          controller: nameController,
                          decoration: const InputDecoration(
                            labelText: 'Full name',
                            border: OutlineInputBorder(),
                          ),
                          textCapitalization: TextCapitalization.words,
                          validator: (v) => v == null || v.trim().isEmpty
                              ? 'Enter your name'
                              : null,
                        ),
                        const SizedBox(height: 12),
                        TextFormField(
                          controller: phoneController,
                          keyboardType: TextInputType.phone,
                          decoration: const InputDecoration(
                            labelText: 'Phone number',
                            border: OutlineInputBorder(),
                          ),
                          validator: (v) => v == null || v.trim().isEmpty
                              ? 'Enter your phone number'
                              : null,
                        ),
                        const SizedBox(height: 12),
                        TextFormField(
                          controller: addressController,
                          maxLines: 2,
                          decoration: const InputDecoration(
                            labelText: 'Full delivery address',
                            border: OutlineInputBorder(),
                          ),
                          validator: (v) => v == null || v.trim().isEmpty
                              ? 'Enter your delivery address'
                              : null,
                        ),
                        const SizedBox(height: 12),
                        TextFormField(
                          controller: instructionsController,
                          decoration: const InputDecoration(
                            labelText: 'Landmark / delivery instructions (optional)',
                            border: OutlineInputBorder(),
                          ),
                        ),
                        const SizedBox(height: 20),
                        Text(
                          'Payment method',
                          style: Theme.of(context).textTheme.titleLarge,
                        ),
                        RadioListTile<String>(
                          contentPadding: EdgeInsets.zero,
                          title: const Text('Cash on Delivery (COD)'),
                          value: 'cod',
                          groupValue: paymentMethod,
                          onChanged: submitting
                              ? null
                              : (v) => updateSheet(
                                    () => paymentMethod = v!,
                                  ),
                        ),
                        RadioListTile<String>(
                          contentPadding: EdgeInsets.zero,
                          title: const Text('QR Payment'),
                          subtitle: const Text(
                            'Payment remains pending until hotel staff verifies it.',
                          ),
                          value: 'qr',
                          groupValue: paymentMethod,
                          onChanged: submitting
                              ? null
                              : (v) => updateSheet(
                                    () => paymentMethod = v!,
                                  ),
                        ),
                        const SizedBox(height: 12),
                        SizedBox(
                          width: double.infinity,
                          child: ElevatedButton.icon(
                            onPressed: submitting || _cart.isEmpty
                                ? null
                                : () async {
                                    if (!formKey.currentState!.validate()) {
                                      return;
                                    }

                                    updateSheet(() => submitting = true);

                                    try {
                                      final items = _cart.entries.map((entry) {
                                        return <String, dynamic>{
                                          'food_id': entry.key,
                                          'quantity': entry.value['quantity'],
                                          'customizations': <dynamic>[],
                                        };
                                      }).toList();

                                      final response = await context
                                          .read<ApiClient>()
                                          .post(
                                        '/api/v1/orders',
                                        idempotencyKey:
                                            DateTime.now()
                                                .microsecondsSinceEpoch
                                                .toString(),
                                        body: {
                                          'items': items,
                                          'payment_method': paymentMethod,
                                          'address': {
                                            'full_address':
                                                addressController.text.trim(),
                                            'latitude': null,
                                            'longitude': null,
                                            'landmark':
                                                instructionsController.text.trim(),
                                          },
                                          'guest_name':
                                              nameController.text.trim(),
                                          'guest_phone':
                                              phoneController.text.trim(),
                                          'is_guest': true,
                                          'delivery_instructions':
                                              instructionsController.text.trim(),
                                        },
                                      );

                                      final order = response['order'];
                                      if (response['success'] != true ||
                                          order is! Map) {
                                        throw Exception(
                                          response['message'] ??
                                              'Order could not be confirmed.',
                                        );
                                      }

                                      final orderNumber =
                                          '${order['order_number'] ?? 'Received'}';
                                      final trackingToken =
                                          '${response['tracking_token'] ?? ''}';

                                      if (!sheetContext.mounted) return;
                                      Navigator.pop(sheetContext);

                                      if (!mounted) return;
                                      setState(() => _cart.clear());

                                      await showDialog<void>(
                                        context: this.context,
                                        barrierDismissible: false,
                                        builder: (dialogContext) => AlertDialog(
                                          icon: const Icon(
                                            Icons.check_circle,
                                            color: MegaTheme.forestGreen,
                                            size: 48,
                                          ),
                                          title: const Text('Order received'),
                                          content: SelectableText(
                                            'Order: $orderNumber\n'
                                            'Payment: ${paymentMethod.toUpperCase()}\n'
                                            '${trackingToken.isNotEmpty ? 'Tracking token: $trackingToken\n' : ''}'
                                            '${paymentMethod == 'qr' ? 'QR payment is pending staff verification.' : 'Please pay cash when your order arrives.'}',
                                          ),
                                          actions: [
                                            TextButton(
                                              onPressed: () =>
                                                  Navigator.pop(dialogContext),
                                              child: const Text('Done'),
                                            ),
                                          ],
                                        ),
                                      );
                                    } catch (e) {
                                      if (sheetContext.mounted) {
                                        updateSheet(() => submitting = false);
                                        ScaffoldMessenger.of(sheetContext)
                                          ..hideCurrentSnackBar()
                                          ..showSnackBar(
                                            SnackBar(
                                              content: Text(
                                                'Order failed: $e',
                                              ),
                                            ),
                                          );
                                      }
                                    }
                                  },
                            icon: submitting
                                ? const SizedBox(
                                    width: 18,
                                    height: 18,
                                    child: CircularProgressIndicator(
                                      strokeWidth: 2,
                                    ),
                                  )
                                : const Icon(Icons.shopping_bag_outlined),
                            label: Text(
                              submitting ? 'Submitting…' : 'Place order',
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              );
            },
          );
        },
      );
    } finally {
      nameController.dispose();
      phoneController.dispose();
      addressController.dispose();
      instructionsController.dispose();
    }
  }

  @override
  Widget build(BuildContext context) {
    final auth = context.watch<AuthState>();

    final visibleFoods = _foods.where((item) {
      final food = Map<String, dynamic>.from(item as Map);
      final categoryId = '${food['category_id'] ?? ''}';
      final name = '${food['name'] ?? food['name_en'] ?? ''}'.toLowerCase();
      final query = _searchQuery.trim().toLowerCase();

      final categoryMatches = _selectedCategoryId == null ||
          categoryId == _selectedCategoryId;
      final searchMatches = query.isEmpty || name.contains(query);

      return categoryMatches && searchMatches;
    }).toList();

    Widget foodImage(String? url, {double height = 135}) {
      if (url == null || url.trim().isEmpty) {
        return Container(
          height: height,
          color: MegaTheme.creamDark,
          alignment: Alignment.center,
          child: const Icon(
            Icons.restaurant,
            size: 42,
            color: MegaTheme.forestGreen,
          ),
        );
      }

      return Image.network(
        url,
        height: height,
        width: double.infinity,
        fit: BoxFit.cover,
        errorBuilder: (_, __, ___) => Container(
          height: height,
          color: MegaTheme.creamDark,
          alignment: Alignment.center,
          child: const Icon(Icons.restaurant, size: 42),
        ),
      );
    }

    return Scaffold(
      appBar: AppBar(
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'MEGHA HOTEL',
              style: TextStyle(fontWeight: FontWeight.w800, letterSpacing: 1),
            ),
            Text(
              'Delicious food, delivered',
              style: Theme.of(context).textTheme.labelSmall,
            ),
          ],
        ),
        actions: [
          IconButton(
            tooltip: 'Cart ($_cartCount items)',
            onPressed: _openCart,
            icon: Badge(
              isLabelVisible: _cartCount > 0,
              label: Text('$_cartCount'),
              child: const Icon(Icons.shopping_bag_outlined),
            ),
          ),
          const SizedBox(width: 8),
        ],
      ),
      body: _loading
          ? const Center(child: CircularProgressIndicator())
          : _error != null
              ? Center(
                  child: Padding(
                    padding: const EdgeInsets.all(24),
                    child: Column(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        const Icon(Icons.wifi_off, size: 44),
                        const SizedBox(height: 12),
                        Text(_error!, textAlign: TextAlign.center),
                        const SizedBox(height: 12),
                        ElevatedButton(
                          onPressed: _load,
                          child: const Text('Try again'),
                        ),
                      ],
                    ),
                  ),
                )
              : _selectedTab == 2
                  ? _simplePage(
                      icon: Icons.receipt_long_outlined,
                      title: 'My Orders',
                      message:
                          'Order history is not available yet. Keep your order tracking token after placing an order.',
                    )
                  : _selectedTab == 3
                      ? _simplePage(
                          icon: Icons.person_outline,
                          title: 'My Profile',
                          message: auth.isAuthenticated
                              ? 'You are signed in.'
                              : 'Sign in to access your account.',
                          actionLabel:
                              auth.isAuthenticated ? null : 'Sign in',
                          onAction: auth.isAuthenticated
                              ? null
                              : () => Navigator.pushNamed(context, '/login'),
                        )
                      : RefreshIndicator(
                          onRefresh: _load,
                          child: ListView(
                            padding: const EdgeInsets.only(bottom: 24),
                            children: [
                              Padding(
                                padding: const EdgeInsets.fromLTRB(16, 18, 16, 12),
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Text(
                                      _selectedTab == 1
                                          ? 'Explore categories'
                                          : 'Hungry? Let’s fix that.',
                                      style: Theme.of(context)
                                          .textTheme
                                          .headlineSmall
                                          ?.copyWith(
                                            fontWeight: FontWeight.w800,
                                          ),
                                    ),
                                    const SizedBox(height: 5),
                                    Text(
                                      _selectedTab == 1
                                          ? 'Choose a category to find your favourites.'
                                          : 'Your favourite meals, just a few taps away.',
                                      style: const TextStyle(
                                        color: MegaTheme.textSecondary,
                                      ),
                                    ),
                                  ],
                                ),
                              ),

                              // Search
                              Padding(
                                padding: const EdgeInsets.symmetric(horizontal: 16),
                                child: TextField(
                                  onChanged: (value) =>
                                      setState(() => _searchQuery = value),
                                  decoration: InputDecoration(
                                    hintText: 'Search momo, chowmein, biryani...',
                                    prefixIcon: const Icon(Icons.search),
                                    filled: true,
                                    fillColor: MegaTheme.cream,
                                    border: OutlineInputBorder(
                                      borderRadius: BorderRadius.circular(16),
                                      borderSide: BorderSide.none,
                                    ),
                                  ),
                                ),
                              ),
                              const SizedBox(height: 18),

                              // Promotional banner from the backend
                              if (_selectedTab == 0)
                                Padding(
                                  padding: const EdgeInsets.symmetric(horizontal: 16),
                                  child: Container(
                                    height: 155,
                                    decoration: BoxDecoration(
                                      borderRadius: BorderRadius.circular(20),
                                      gradient: const LinearGradient(
                                        colors: [
                                          MegaTheme.forestGreen,
                                          MegaTheme.forestGreenLight,
                                        ],
                                        begin: Alignment.topLeft,
                                        end: Alignment.bottomRight,
                                      ),
                                    ),
                                    clipBehavior: Clip.antiAlias,
                                    child: _banners.isNotEmpty
                                        ? PageView.builder(
                                            itemCount: _banners.length,
                                            itemBuilder: (_, index) {
                                              final banner = Map<String, dynamic>.from(
                                                _banners[index] as Map,
                                              );
                                              final imageUrl =
                                                  banner['image_url']?.toString();
                                              return Stack(
                                                fit: StackFit.expand,
                                                children: [
                                                  if (imageUrl != null &&
                                                      imageUrl.isNotEmpty)
                                                    Image.network(
                                                      imageUrl,
                                                      fit: BoxFit.cover,
                                                      errorBuilder: (_, __, ___) =>
                                                          const SizedBox(),
                                                    ),
                                                  Container(
                                                    color: Colors.black.withValues(
                                                      alpha: 0.30,
                                                    ),
                                                  ),
                                                  Padding(
                                                    padding: const EdgeInsets.all(20),
                                                    child: Column(
                                                      crossAxisAlignment:
                                                          CrossAxisAlignment.start,
                                                      mainAxisAlignment:
                                                          MainAxisAlignment.center,
                                                      children: [
                                                        Text(
                                                          '${banner['title'] ?? 'Fresh & delicious'}',
                                                          style: const TextStyle(
                                                            color: Colors.white,
                                                            fontSize: 23,
                                                            fontWeight: FontWeight.w800,
                                                          ),
                                                        ),
                                                        const SizedBox(height: 6),
                                                        Text(
                                                          '${banner['subtitle'] ?? 'Order your favourites today'}',
                                                          style: const TextStyle(
                                                            color: Colors.white,
                                                          ),
                                                        ),
                                                      ],
                                                    ),
                                                  ),
                                                ],
                                              );
                                            },
                                          )
                                        : const Padding(
                                            padding: EdgeInsets.all(20),
                                            child: Column(
                                              crossAxisAlignment:
                                                  CrossAxisAlignment.start,
                                              mainAxisAlignment:
                                                  MainAxisAlignment.center,
                                              children: [
                                                Text(
                                                  'GOOD FOOD, GOOD MOOD',
                                                  style: TextStyle(
                                                    color: Colors.white70,
                                                    fontWeight: FontWeight.w700,
                                                    letterSpacing: 1.2,
                                                  ),
                                                ),
                                                SizedBox(height: 8),
                                                Text(
                                                  'Your cravings,\nour kitchen.',
                                                  style: TextStyle(
                                                    color: Colors.white,
                                                    fontSize: 25,
                                                    fontWeight: FontWeight.w800,
                                                  ),
                                                ),
                                              ],
                                            ),
                                          ),
                                  ),
                                ),
                              const SizedBox(height: 22),

                              // Category filters
                              Padding(
                                padding: const EdgeInsets.symmetric(horizontal: 16),
                                child: Row(
                                  children: [
                                    Expanded(
                                      child: Text(
                                        'Categories',
                                        style: Theme.of(context)
                                            .textTheme
                                            .titleLarge
                                            ?.copyWith(
                                              fontWeight: FontWeight.w800,
                                            ),
                                      ),
                                    ),
                                    TextButton(
                                      onPressed: () => setState(() {
                                        _selectedTab = 1;
                                        _selectedCategoryId = null;
                                      }),
                                      child: const Text('See all'),
                                    ),
                                  ],
                                ),
                              ),
                              SizedBox(
                                height: 48,
                                child: ListView(
                                  scrollDirection: Axis.horizontal,
                                  padding: const EdgeInsets.symmetric(horizontal: 16),
                                  children: [
                                    Padding(
                                      padding: const EdgeInsets.only(right: 8),
                                      child: ChoiceChip(
                                        label: const Text('All'),
                                        selected: _selectedCategoryId == null,
                                        onSelected: (_) => setState(
                                          () => _selectedCategoryId = null,
                                        ),
                                      ),
                                    ),
                                    ..._categories.map((item) {
                                      final category =
                                          Map<String, dynamic>.from(item as Map);
                                      final id = '${category['id'] ?? ''}';
                                      final selected =
                                          _selectedCategoryId == id;
                                      return Padding(
                                        padding: const EdgeInsets.only(right: 8),
                                        child: ChoiceChip(
                                          label: Text(
                                            '${category['name'] ?? category['name_en'] ?? 'Category'}',
                                          ),
                                          selected: selected,
                                          onSelected: (_) => setState(
                                            () => _selectedCategoryId =
                                                selected ? null : id,
                                          ),
                                        ),
                                      );
                                    }),
                                  ],
                                ),
                              ),
                              const SizedBox(height: 18),

                              Padding(
                                padding: const EdgeInsets.symmetric(horizontal: 16),
                                child: Text(
                                  _selectedCategoryId == null
                                      ? 'Popular menu'
                                      : 'Selected category',
                                  style: Theme.of(context)
                                      .textTheme
                                      .titleLarge
                                      ?.copyWith(fontWeight: FontWeight.w800),
                                ),
                              ),
                              const SizedBox(height: 12),

                              if (visibleFoods.isEmpty)
                                const Padding(
                                  padding: EdgeInsets.all(32),
                                  child: Center(
                                    child: Text('No matching food items found.'),
                                  ),
                                )
                              else
                                Padding(
                                  padding: const EdgeInsets.symmetric(horizontal: 12),
                                  child: GridView.builder(
                                    shrinkWrap: true,
                                    physics:
                                        const NeverScrollableScrollPhysics(),
                                    itemCount: visibleFoods.length,
                                    gridDelegate:
                                        const SliverGridDelegateWithFixedCrossAxisCount(
                                      crossAxisCount: 2,
                                      crossAxisSpacing: 10,
                                      mainAxisSpacing: 12,
                                      childAspectRatio: 0.64,
                                    ),
                                    itemBuilder: (context, index) {
                                      final food =
                                          Map<String, dynamic>.from(
                                        visibleFoods[index] as Map,
                                      );
                                      final id = '${food['id'] ?? ''}';
                                      final qty =
                                          _cart[id]?['quantity'] ?? 0;
                                      final available =
                                          food['available'] == true;

                                      return Container(
                                        decoration: BoxDecoration(
                                          color: Theme.of(context).cardColor,
                                          borderRadius:
                                              BorderRadius.circular(18),
                                          border: Border.all(
                                            color: MegaTheme.creamDark,
                                          ),
                                        ),
                                        clipBehavior: Clip.antiAlias,
                                        child: Column(
                                          crossAxisAlignment:
                                              CrossAxisAlignment.start,
                                          children: [
                                            Stack(
                                              children: [
                                                SizedBox(
                                                  width: double.infinity,
                                                  child: foodImage(
                                                    food['image_url']?.toString(),
                                                  ),
                                                ),
                                                if (food['is_vegetarian'] == true)
                                                  const Positioned(
                                                    top: 8,
                                                    left: 8,
                                                    child: Icon(
                                                      Icons.eco,
                                                      color: Colors.green,
                                                      size: 20,
                                                    ),
                                                  ),
                                              ],
                                            ),
                                            Expanded(
                                              child: Padding(
                                                padding:
                                                    const EdgeInsets.all(10),
                                                child: Column(
                                                  crossAxisAlignment:
                                                      CrossAxisAlignment.start,
                                                  children: [
                                                    Text(
                                                      '${food['name'] ?? food['name_en'] ?? 'Food'}',
                                                      maxLines: 2,
                                                      overflow:
                                                          TextOverflow.ellipsis,
                                                      style: const TextStyle(
                                                        fontWeight:
                                                            FontWeight.w700,
                                                      ),
                                                    ),
                                                    const Spacer(),
                                                    Text(
                                                      'NPR ${food['base_price'] ?? '0.00'}',
                                                      style: const TextStyle(
                                                        color:
                                                            MegaTheme.forestGreen,
                                                        fontSize: 15,
                                                        fontWeight:
                                                            FontWeight.w800,
                                                      ),
                                                    ),
                                                    const SizedBox(height: 8),
                                                    SizedBox(
                                                      width: double.infinity,
                                                      height: 36,
                                                      child: ElevatedButton(
                                                        onPressed: available
                                                            ? () => _addFood(food)
                                                            : null,
                                                        child: Text(
                                                          !available
                                                              ? 'Unavailable'
                                                              : qty > 0
                                                                  ? 'Add more ($qty)'
                                                                  : '＋ Add',
                                                          style: const TextStyle(
                                                            fontSize: 12,
                                                          ),
                                                        ),
                                                      ),
                                                    ),
                                                  ],
                                                ),
                                              ),
                                            ),
                                          ],
                                        ),
                                      );
                                    },
                                  ),
                                ),
                              const SizedBox(height: 24),
                              Center(
                                child: TextButton(
                                  onPressed: () async {
                                    final uri = Uri.parse(
                                      'https://bamstudio.argan.com.np/',
                                    );
                                    if (await canLaunchUrl(uri)) {
                                      await launchUrl(
                                        uri,
                                        mode: LaunchMode.externalApplication,
                                      );
                                    }
                                  },
                                  child: const Text(
                                    'Technology by BAM Studio',
                                    style: TextStyle(
                                      fontSize: 12,
                                      color: MegaTheme.textSecondary,
                                    ),
                                  ),
                                ),
                              ),
                            ],
                          ),
                        ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: _selectedTab,
        onDestinationSelected: (index) {
          setState(() {
            _selectedTab = index;
            if (index == 0) _selectedCategoryId = null;
          });
        },
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(Icons.home),
            label: 'Home',
          ),
          NavigationDestination(
            icon: Icon(Icons.grid_view_outlined),
            selectedIcon: Icon(Icons.grid_view),
            label: 'Categories',
          ),
          NavigationDestination(
            icon: Icon(Icons.receipt_long_outlined),
            selectedIcon: Icon(Icons.receipt_long),
            label: 'My Orders',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline),
            selectedIcon: Icon(Icons.person),
            label: 'Profile',
          ),
        ],
      ),
    );
  }

  Widget _simplePage({
    required IconData icon,
    required String title,
    required String message,
    String? actionLabel,
    VoidCallback? onAction,
  }) {
    return Center(
      child: Padding(
        padding: const EdgeInsets.all(28),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(icon, size: 64, color: MegaTheme.forestGreen),
            const SizedBox(height: 16),
            Text(
              title,
              style: const TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.w800,
              ),
            ),
            const SizedBox(height: 8),
            Text(message, textAlign: TextAlign.center),
            if (actionLabel != null && onAction != null) ...[
              const SizedBox(height: 16),
              ElevatedButton(
                onPressed: onAction,
                child: Text(actionLabel),
              ),
            ],
          ],
        ),
      ),
    );
  }
}

