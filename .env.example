# Mega Hotel - Example environment configuration
# Copy to backend/.env locally and replace placeholders with real values.
# Never commit backend/.env.

FLASK_ENV=production
FLASK_DEBUG=false

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Configure these in Vercel Environment Variables
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=admin@megahotel.local
ADMIN_PASSWORD_HASH=

DEFAULT_DELIVERY_FEE=50.00
DEFAULT_MINIMUM_ORDER=0.00
TIMEZONE=Asia/Kathmandu
MINIMUM_APP_VERSION=1.0.0

RATELIMIT_DEFAULT=200 per day;50 per hour
CORS_ORIGINS=*

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mega_hotel

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FCM_SERVER_KEY=
FCM_SENDER_ID=
GOOGLE_MAPS_API_KEY=
